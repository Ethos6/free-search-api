# Copy to .env and edit. Every setting is optional.

# Engines used when a request doesn't specify any (comma-separated)
FREESEARCH_ENGINES=duckduckgo,brave,bing,yahoo,wikipedia
# Opt-in extras: mojeek, google (experimental), searxng
FREESEARCH_NEWS_ENGINES=bing_news,google_news

# Per-engine timeout in seconds
FREESEARCH_TIMEOUT=6

# Protect a public server: comma-separated keys. Empty = no auth.
FREESEARCH_API_KEYS=

# Requests per minute per key / IP. 0 = unlimited
FREESEARCH_RATE_LIMIT=0

# Outbound proxies, rotated round-robin (http://, https://, socks5://, socks5h://)
FREESEARCH_PROXIES=

# Cache results (seconds). Redis is used when FREESEARCH_REDIS_URL is set.
FREESEARCH_CACHE_TTL=3600
FREESEARCH_CACHE_SIZE=4096
FREESEARCH_REDIS_URL=

# Add your own SearXNG instance as an extra engine
FREESEARCH_SEARXNG_URL=

FREESEARCH_CORS_ORIGINS=*
